{
  "name": "nuxt-saas-starter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nuxt dev",
    "test": "vitest run --silent=false",
    "test:unit": "vitest run --project unit",
    "test:ci": "vitest run --project unit --project nuxt",
    "test:ci:coverage": "vitest run --project unit --project nuxt --coverage",
    "coverage": "pnpm run test:ci:coverage",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "nuxt typecheck",
    "auth:schema": "pnpm exec auth generate --config server/utils/auth.ts --output server/db/schema/auth.ts --yes",
    "db:generate": "drizzle-kit generate --config ./server/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config ./server/db/drizzle.config.ts",
    "demo:seed": "node scripts/demo/seed.ts",
    "demo:reset": "node scripts/demo/reset.ts",
    "build": "nuxt build",
    "serve": "node .output/server/index.mjs",
    "preview:cf": "wrangler dev",
    "deploy": "wrangler deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.25",
    "@better-auth/stripe": "^1.7.25",
    "@internationalized/date": "3.12.4",
    "@nuxt/ui": "^4.12.2",
    "@nuxthub/core": "^0.10.12",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^6.0.1",
    "@tanstack/vue-table": "8.21.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.25",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "ioredis": "^5.11.1",
    "nuxt": "^4.6.4",
    "nuxt-echarts": "^1.1.0",
    "ofetch": "^1.5.1",
    "pg": "^8.23.1",
    "resend": "^6.38.1",
    "sortablejs": "^1.15.7",
    "stripe": "^23.1.0",
    "unstorage": "^1.17.6",
    "uuid": "^14.0.3",
    "vue": "^3.5.45",
    "vue-component-type-helpers": "^3.3.14",
    "vue-echarts": "^8.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify-json/simple-icons": "^1.2.103",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/test-utils": "^2.6.0",
    "auth": "1.7.25",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "playwright-core": "^1.65.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.13",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.163.0"
  }
}
